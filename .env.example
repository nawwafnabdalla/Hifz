# Public client configuration. Both values are safe to expose in a browser build
# (the publishable key only works through Row Level Security).
# NEVER put a service_role / secret key in any VITE_* variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
